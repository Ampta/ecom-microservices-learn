# Port Mappings (Host Ports)
# Avoid host port 3306 if local MySQL is running on your machine
USER_DB_PORT=3309
PRODUCT_DB_PORT=3307
ORDER_DB_PORT=3308

# MySQL Credentials & Database Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=appuser
MYSQL_PASSWORD=apppassword

# Redis Configuration
REDIS_PORT=6379
REDIS_PASSWORD=redispassword